{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Koza set1",
            "type": "debugpy",
            "request": "launch",
            "module": "t_search",
            "args": [
                "--dataset", "koza_1",
                "--config", "configs/koza_set1.json",
                "--output", "data/results.jsonlist",
                "--device", "cuda",
                "--dtype", "float32",
                "--seed", "42",
                "--debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG_SOLVER": "1"
            },
            "stopOnEntry": false
        },
        {
            "name": "Koza set2",
            "type": "debugpy",
            "request": "launch",
            "module": "t_search",
            "args": [
                "--dataset", "koza_2",
                "--config", "configs/koza_set2.json",
                "--output", "data/results.jsonlist",
                "--device", "cuda",
                "--dtype", "float32",
                "--seed", "42",
                "--debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG_SOLVER": "1"
            },
            "stopOnEntry": false
        }        
    ]
}
{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "All DS",
            "type": "debugpy",
            "request": "launch",
            "module": "t_search.datasets",
            "args": [
                "--list-ds",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG_SOLVER": "1"
            },
            "stopOnEntry": false
        },        
        {
            "name": "Point optim",
            "type": "debugpy",
            "request": "launch",
            "module": "t_search",
            "args": [
                "--dataset", "korns_13",
                "--config", "configs/point_optim.json",
                "--output", "data/dbg.jsonlist",
                "--device", "cuda",
                "--dtype", "float32",
                "--seed", "42",
                "--debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG_SOLVER": "1"
            },
            "stopOnEntry": false
        },

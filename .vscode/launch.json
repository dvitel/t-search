{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Koza set1",
            "type": "debugpy",
            "request": "launch",
            "module": "experiments.koza",
            "args": [
                "--dataset", "test_0",
                "--config", "experiments/config/koza-base-set1.json",
                "--output", "data/koza-set1-{}-results.json",
                "--device", "cuda",
                "--dtype", "float16",
                "--seed", "42"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "stopOnEntry": false
        }
    ]
}
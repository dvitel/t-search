{
    "service_definitions": {
        "fitness": { 
            "type": "Fitness", 
            "params": {
                "fitness_atol": 1e-07
            }
        },        
        "semantics": {
            "type": "Semantics", 
            "params": { 
                "storage": {"!ref": "term_vector_storage"}
            }
        },        
        "vector_storage": {"type": "VectorStorage", "params": {
            "atol": 0.0001,
            "rtol": 0.0001
        }},
        "syntax": { 
            "type": "Syntax", 
            "params": { 
                "max_term_depth": 17,
                "min_consts": 0,
                "max_consts": 10,
                "min_vars": 1,
                "max_vars": 100,
                "prohibit_ops_on_consts_only": true,
                "ops_counts": {
                    "pow": [0, 10],
                    "neg": [0, 10],
                    "inv": [0, 10],
                    "div": [0, 10],
                    "sub": [0, 10],
                    "exp": [0, 10],
                    "log": [0, 10],
                    "sin": [0, 10],
                    "cos": [0, 10]
                },
                "inner_ops_max_counts": {
                    "exp": {"exp": 0, "sin": 0, "cos": 0},
                    "log": {"log": 0, "cos": 0, "sin": 0},
                    "pow": {"pow": 0},
                    "sin": {"sin": 0, "cos": 0, "log": 0, "exp": 0},
                    "cos": {"cos": 0, "sin": 0, "log": 0, "exp": 0}
                },
                "immediate_arg_limits": {
                    "inv": {
                        "inv": 0,
                        "mul": 0
                    },
                    "neg": {
                        "neg": 0
                    },
                    "log": {"exp": 0},
                    "exp": {"log": 0}        
                },
                "commutative": ["add", "mul"]
            }
        },
        "term_vector_storage": { 
            "type": "TermVectorStorage", 
            "params": { 
                "index": {"!ref": "vector_storage"}
            } 
        },
        "evaluator": {
            "type": "Evaluator", 
            "params": {
                "with_inner_evals": true,
                "max_root_evals": 500000,
                "max_evals": 500000,
                "measure_loss_each_n": 2000,
                "measure_max_len": 200
            }
        },
        "init": {
            "type": "SemanticallyDrivenInitialization", 
            "module": "t_search.operators.semantic",
            "params": { 
                "atol": 1e-4,
                "rtol": 1e-4,
                "semantic_duplicate_retries": 10,
                "max_depth": 6,                
                "max_l2": 1e20,
                "size": 1000 
            } 
        },
        "selection": { 
            "type": "SemanticTournamentSelection", 
            "module": "t_search.operators.semantic",
            "params": { 
                "atol": 1e-2,
                "rtol": 1e-2,                
                "selection_size": 1000, 
                "tournament_size": 7 
            } 
        },
        "mutation": { 
            "type": "SemanticallyDrivenMutation", 
            "module": "t_search.operators.semantic",
            "params": { 
                "min_d": 1e-4,
                "max_d": 100,
                "max_pos_tries": 10,
                "rate": 0.1
            } 
        },
        "crossover": { 
            "type": "SemanticallyDrivenCrossover", 
            "module": "t_search.operators.semantic",
            "params": { 
                "min_d": 1e-4,
                "max_d": 100,
                "max_pos_tries": 10,                
                "rate": 0.9
            } 
        },
        "survivor_selection": { 
            "type": "MuLambdaSurvivorSelection", 
            "module": "t_search.operators.classic",
            "params": { 
                "mu": 1000, 
                "strict": false, 
                "combine": false,
                "elitism": 10
            }
        }
    },
    "init_service_name": "init",
    "operator_service_names": [
        "selection",
        "crossover",
        "mutation",
        "evaluator",
        "survivor_selection"
    ],
    "ops": ["add", "sub", "mul", "div", "exp", "log", "sin", "cos"],
    "evaluator_service_name": "evaluator",
    "syntax_service_name": "syntax",
    "fitness_service_name": "fitness",
    "semantics_service_name": "semantics",
    "max_gen": 1000,
    "max_dim_size": 1000
}
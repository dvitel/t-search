{
    "!base": "./base.json",
    "service_definitions": {
        "fitness": { 
            "type": "Fitness", 
            "params": {
                "syntax": {"!ref": "syntax"},
                "fitness_name": "nmse",
                "fitness_atol": 1e-07
            }
        },        
        "semantics": {
            "type": "Semantics", 
            "params": { 
                "storage": {"!ref": "term_vector_storage"}
            }
        },        
        "vector_storage": {"type": "SpatialIndex", "params": {}},
        "syntax": { 
            "type": "Syntax", 
            "params": { 
                "max_term_depth": 17,
                "min_consts": 0,
                "max_consts": 100,
                "min_vars": 1,
                "max_vars": 100,
                "prohibit_ops_on_consts_only": false
            }
        },
        "term_vector_storage": { 
            "type": "TermVectorStorage", 
            "params": { 
                "index": {"!ref": "vector_storage"},
                "normalizer": {"!ref": "identity"}
            } 
        },        
        "evaluator": {
            "type": "DefaultEvaluator", 
            "params": {
                "semantics": {"!ref": "semantics"},
                "fitness": {"!ref": "fitness"},                
                "with_inner_evals": true,
                "max_root_evals": 100000,
                "max_evals": 1000000,
                "listeners": [
                ]                
            }
        },
        "reducer": {
            "type": "Reduce",
            "module": "t_search.operators.syntax",
            "params": {
                "syntax": {"!ref": "syntax"},
                "evaluator": {"!ref": "evaluator"},
                "rate": 1.0
            }
        },        
        "init": {
            "type": "RHH", 
            "module": "t_search.operators.classic",
            "params": { "size": 1000 } 
        },
        "selection": { 
            "type": "TS", 
            "module": "t_search.operators.classic",
            "params": { "selection_size": 1000, "tournament_size": 7 } 
        },
        "mutation": { 
            "type": "RPM", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.1 } 
        },
        "crossover": { 
            "type": "RPX", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.9 } 
        },
        "survivor_selection": { 
            "type": "MuLambdaSurvivorSelection", 
            "module": "t_search.operators.classic",
            "params": { 
                "evaluator": {"!ref": "evaluator"},
                "mu": 1000, 
                "strict": false, 
                "combine": false,
                "elitism": 10
            } 
        },
        "reduce_consts": {
            "type": "ReduceConsts",
            "module": "t_search.operators.syntax",
            "params": {
                "evaluator": {"!ref": "evaluator"},
                "semantics": {"!ref": "semantics"},
                "syntax": {"!ref": "syntax"},
                "rate": 1.0
            }
        }
    },
    "init_service_name": "init",
    "operator_service_names": [        
        "selection",
        "mutation",
        "crossover",
        "evaluator",
        "survivor_selection"
    ],
    "ops": ["add", "mul", "neg", "inv", "exp", "log", "sin", "cos"],
    "max_dim_size": 1000
}
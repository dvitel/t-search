{
    "service_definitions": {
        "normalizer": {
            "type": "ZScoreNormalizer",
            "params": {
                "small_std": 1e-4
            }
        },        
        "fitness": { 
            "type": "Fitness", 
            "params": {
                "syntax": {"!ref": "syntax"},
                "fitness_name": "nmse",
                "fitness_atol": 1e-07
            }
        },        
        "semantics": {
            "type": "Semantics", 
            "params": { 
                "storage": {"!ref": "term_vector_storage"}
            }
        },        
        "vector_storage": {"type": "SpatialIndex", "params": {}},
        "syntax": { 
            "type": "Syntax", 
            "params": { 
                "max_term_depth": 17,
                "min_consts": 0,
                "max_consts": 10,
                "min_vars": 1,
                "max_vars": 100,
                "prohibit_ops_on_consts_only": true,
                "ops_counts": {
                    "pow": [0, 10],
                    "neg": [0, 10],
                    "inv": [0, 10],
                    "div": [0, 10],
                    "sub": [0, 10],
                    "exp": [0, 10],
                    "log": [0, 10],
                    "sin": [0, 10],
                    "cos": [0, 10]
                },
                "inner_ops_max_counts": {
                    "exp": {"exp": 0},
                    "log": {"log": 0},
                    "pow": {"pow": 0},
                    "sin": {"sin": 0, "cos": 0},
                    "cos": {"cos": 0, "sin": 0}
                },
                "immediate_arg_limits": {
                    "inv": {
                        "inv": 0,
                        "mul": 0
                    },
                    "neg": {
                        "neg": 0,
                        "add": 0
                    },
                    "log": {"exp": 0},
                    "exp": {"log": 0}        
                },
                "commutative": ["add", "mul"]
            }
        },
        "term_vector_storage": { 
            "type": "TermVectorStorage", 
            "params": { 
                "index": {"!ref": "vector_storage"}
            } 
        },          
        "init": {
            "type": "Up2D", 
            "module": "t_search.operators.classic",
            "params": { "depth": 1 } 
        },
        "selection": { 
            "type": "TS", 
            "module": "t_search.operators.classic",
            "params": { "selection_size": 10, "tournament_size": 7 } 
        },
        "mutation": { 
            "type": "RPM", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.1 } 
        },
        "crossover": { 
            "type": "RPX", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.9 } 
        },
        "survivor_selection": { 
            "type": "MuLambdaSurvivorSelection", 
            "module": "t_search.operators.classic",
            "params": { 
                "evaluator": {"!ref": "evaluator"},
                "mu": 100, 
                "strict": false, 
                "combine": false,
                "elitism": 0
            } 
        },
        "sreduce": {
            "type": "SReduce",
            "module": "t_search.operators.semantic",
            "params": {
                "semantics": {"!ref": "semantics"},
                "syntax": {"!ref": "syntax"},
                "evaluator": {"!ref": "evaluator"},
                "rate": 1.0
            }
        },
        "term_index_storage": {"type": "RTreeIndex", "params": {}},
        "term_index": {
            "type": "TermVectorStorage",
            "params": { 
                "index": {"!ref": "term_index_storage"}                
            } 
        },
        "hole_index_storage": {"type": "RTreeIndex", "params": {}},
        "hole_index": {
            "type": "HoleVectorStorage",
            "params": { 
                "index": {"!ref": "hole_index_storage"}
            } 
        },
        "term_hole_pairs": {
            "type": "TermHolePairs",
            "module": "t_search.operators.optim.term_hole",
            "params": {
                "syntax": {"!ref": "syntax"},
                "term_index": {"!ref": "term_index"},
                "hole_index": {"!ref": "hole_index"},
                "const_optimizer": {"!ref": "const_optimizer"},
                "normalizer": {"!ref": "normalizer"},
                "term_filter_strategy": "term_filter_accept_all",
                "hole_filter_strategy": "hole_filter_accept_all",
                "start_delta": 1,
                "multiplier": 10,
                "num_steps": 3,
                "num_closest": 1,
                "good_filling_loss": 0.001,
                "max_filling_queue_size": 100,
                "small_value": 1e-2,
                "small_variation": 1e-4
            }
        },
        "evaluator": {
            "type": "DefaultEvaluator", 
            "params": {
                "semantics": {"!ref": "semantics"},
                "fitness": {"!ref": "fitness"},                
                "with_inner_evals": true,
                "max_root_evals": 100000,
                "max_evals": 1000000             
            }
        },        
        "point_optim": {
            "type": "PointOptim",
            "module": "t_search.operators.optim.point_optim",
            "params": {
                "term_hole_pairs": {"!ref": "term_hole_pairs"},
                "syntax": {"!ref": "syntax"},
                "fitness": {"!ref": "fitness"},
                "semantics": {"!ref": "semantics"},
                "evaluator": {"!ref": "evaluator"},
                "position_strategy": "best_grad_position_order",
                "num_starts": 30,
                "range_delta": 0.1,
                "max_evals": 30,
                "lr": 1,
                "tolerance_change": 0.0000001,
                "tolerance_grad": 0.000001,
                "min_loss_rtol": 0.95,
                "with_tabu": true,
                "max_hole_bindings": 1,
                "num_children": 100
            }
        },
        "const_optimizer": {
            "type": "ConstOptimizer",
            "module": "t_search.evaluators.const_optimizer",
            "params": {
                "syntax": {"!ref": "syntax"},
                "evaluator": {"!ref": "evaluator"},
                "num_starts": 1000,
                "max_evals": 30,
                "lr": 0.1,
                "tolerance_change": 0.0000000001,
                "tolerance_grad": 0.000000001
            }
        },
        "const_optim": {
            "type": "OptimMutation",
            "module": "t_search.operators.optim.optim_mutation",
            "params": {
                "optimizer": {"!ref": "const_optimizer"}
            }
        }
    },
    "init_service_name": "init",
    "operator_service_names": [        
        "point_optim",
        "evaluator",
        "sreduce",
        "survivor_selection"
    ],
    "ops": ["add", "mul", "neg", "inv", "exp", "log", "sin", "cos"],
    "evaluator_service_name": "evaluator",
    "syntax_service_name": "syntax",
    "fitness_service_name": "fitness",
    "semantics_service_name": "semantics",   
    "final_reducer_service_name": "sreduce",
    "eval_listeners": [
        "term_hole_pairs"
    ],  
    "max_gen": 1000,
    "max_dim_size": 1000    
}
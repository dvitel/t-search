{
    "service_definitions": {
        "fitness": { 
            "type": "Fitness", 
            "params": {
                "fitness_atol": 1e-07
            }
        },
        "semantics": {
            "type": "Semantics", 
            "params": { 
                "storage": {"!ref": "term_vector_storage"}
            }
        },        
        "vector_storage": {"type": "SpatialIndex", "params": {}},
        "logger": {
            "type": "Logging", 
            "module": "t_search.operators.misc",
            "params": {"file_path": "data/logs/run_{}.log", "autoflush": true}
        },
        "init": {
            "type": "RHH", 
            "module": "t_search.operators.classic",
            "params": { "size": 1000 } 
        },
        "selection": { 
            "type": "TS", 
            "module": "t_search.operators.classic",
            "params": { "selection_size": 1000, "tournament_size": 7 } 
        },
        "mutation": { 
            "type": "RPM", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.1 } 
        },
        "crossover": { 
            "type": "RPX", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.9 } 
        },
        "survivor_selection": { 
            "type": "MuLambdaSurvivorSelection", 
            "module": "t_search.operators.classic",
            "params": { 
                "evaluator": {"!ref": "evaluator"},
                "mu": 1000, 
                "strict": false, 
                "combine": false,
                "elitism": 10
            } 
        },
        "syntax": { 
            "type": "Syntax", 
            "params": { 
                "max_term_depth": 17,
                "min_consts": 0,
                "max_consts": 100,
                "min_vars": 1,
                "max_vars": 100,
                "ops_counts": {
                    "pow": [0, 5],
                    "neg": [0, 5],
                    "inv": [0, 5],
                    "exp": [0, 5],
                    "log": [0, 5],
                    "sin": [0, 5],
                    "cos": [0, 5]
                },
                "forbid_patterns": [
                    "(exp (log X))", 
                    "(log (exp X))",
                    "(inv (inv .))",
                    "(neg (neg .))",
                    "(sin (... (sin .)))",
                    "(cos (... (cos .)))",
                    "(exp (... (exp .)))",
                    "(log (... (log .)))",
                    "(... pow (pow . .))"
                ],
                "inner_ops_max_counts": {
                    "exp": {"exp": 0},
                    "log": {"log": 0},
                    "pow": {"pow": 1},
                    "inv": {"inv": 1},        
                    "sin": {"sin": 0},
                    "cos": {"cos": 0}
                },
                "immediate_arg_limits": {
                    "inv": {"inv": 0},
                    "neg": {"neg": 0},
                    "log": {"exp": 0},
                    "exp": {"log": 0}        
                },
                "prohibit_ops_on_consts_only": true
            }
        },
        "term_vector_storage": { 
            "type": "TermVectorStorage", 
            "params": { 
                "index": {"!ref": "vector_storage"} 
            } 
        },      
        "evaluator": {
            "type": "DefaultEvaluator", 
            "params": { 
                "semantics": {"!ref": "semantics"},
                "fitness": {"!ref": "fitness"},
                "with_inner_evals": true,
                "max_root_evals": 100000,
                "max_evals": 1000000,
                "listeners": [
                    {"!ref": "logger"}
                ]
            }
        }
    },
    "init_service_name": "init",
    "operator_service_names": [
        "selection",
        "mutation",
        "crossover",
        "evaluator",
        "survivor_selection"
    ],
    "evaluator_service_name": "evaluator",
    "syntax_service_name": "syntax",
    "fitness_service_name": "fitness",
    "semantics_service_name": "semantics",
    "ops": [ "add", "sub", "mul", "div", "pow", "neg", "inv", "exp", "log", "sin", "cos" ],    
    "max_gen": 100
}
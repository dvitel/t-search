{
    "service_definitions": {
        "identity": {
            "type": "IdentityNormalizer",
            "params": {}
        },
        "fitness": { 
            "type": "Fitness", 
            "params": {
                "fitness_name": "nmse",
                "fitness_atol": 1e-04
            }
        },
        "semantics": {
            "type": "Semantics", 
            "params": { 
                "storage": {"!ref": "term_vector_storage"}
            }
        },        
        "vector_storage": {"type": "SpatialIndex", "params": {}},
        "logger": {
            "type": "Logging", 
            "module": "t_search.operators.misc",
            "params": {"file_path": "data/logs/run_{}.log", "autoflush": true}
        },
        "syntax": { 
            "type": "Syntax", 
            "params": { 
                "max_term_depth": 17,
                "min_consts": 0,
                "max_consts": 100,
                "min_vars": 1,
                "max_vars": 100,
                "prohibit_ops_on_consts_only": false
            }
        },
        "term_vector_storage": { 
            "type": "TermVectorStorage", 
            "params": { 
                "index": {"!ref": "vector_storage"},
                "normalizer": {"!ref": "identity"}
            } 
        },        
        "evaluator": {
            "type": "DefaultEvaluator", 
            "params": {
                "semantics": {"!ref": "semantics"},
                "fitness": {"!ref": "fitness"},                
                "with_inner_evals": false,
                "max_root_evals": 100000,
                "max_evals": 1000000,
                "listeners": [
                    {"!ref": "logger"}
                ]                
            }
        }
    },
    "evaluator_service_name": "evaluator",
    "syntax_service_name": "syntax",
    "fitness_service_name": "fitness",
    "semantics_service_name": "semantics",    
    "max_gen": 100
}
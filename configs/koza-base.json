{
    "!base": "./base.json",
    "service_definitions": {
        "init": {
            "type": "RHH", 
            "module": "t_search.operators.classic",
            "params": { "size": 1000 } 
        },
        "selection": { 
            "type": "TS", 
            "module": "t_search.operators.classic",
            "params": { "selection_size": 1000, "tournament_size": 7 } 
        },
        "mutation": { 
            "type": "RPM", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.1 } 
        },
        "crossover": { 
            "type": "RPX", 
            "module": "t_search.operators.classic",
            "params": { "rate": 0.9 } 
        },
        "survivor_selection": { 
            "type": "MuLambdaSurvivorSelection", 
            "module": "t_search.operators.classic",
            "params": { 
                "evaluator": {"!ref": "evaluator"},
                "mu": 1000, 
                "strict": false, 
                "combine": false,
                "elitism": 10
            } 
        },
        "reduce_consts": {
            "type": "ReduceConsts",
            "module": "t_search.operators.syntax",
            "params": {
                "semantics": {"!ref": "semantics"},
                "syntax": {"!ref": "syntax"},
                "rate": 1.0
            }
        }
    },
    "init_service_name": "init",
    "operator_service_names": [        
        "selection",
        "mutation",
        "crossover",
        "evaluator",
        "reduce_consts",
        "survivor_selection"
    ]    
}